                                        SmallVectorImpl<Register> &NewVRegs,
                                        SmallVirtRegSet &FixedRegisters,
@@ -2414,6 +2455,8 @@ MCRegister RAGreedy::selectOrSplitImpl(const LiveInterval &VirtReg,
